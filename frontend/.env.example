# NexLearn frontend — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Canonical production URL used for SEO metadata, sitemap, and OG tags.
# Falls back to Vercel's automatic URL, then localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL (the Express server).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional — Google OAuth client ID used by the Google sign-in button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
