{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "bun-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["worker/**/*.ts", "open-next.config.ts", "scripts/*.ts"],
  "exclude": ["worker/tests"]
}
