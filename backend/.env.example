# NexLearn backend — environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# Required
MONGODB_URI=mongodb://localhost:27017/nexlearn
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
# Cookie domain for split deployments (e.g. your-frontend-domain.com). Unset in dev.
# COOKIE_DOMAIN=
NODE_ENV=development

# Optional — Google sign-in (returns 501 until configured)
# GOOGLE_CLIENT_ID=

# Optional — Appwrite avatar storage (returns 501 until all four are set)
# APPWRITE_ENDPOINT=
# APPWRITE_PROJECT_ID=
# APPWRITE_BUCKET_ID=
# APPWRITE_API_KEY=

# Optional — AI doubt helper (Groq primary, OpenRouter fallback)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_DAILY_LIMIT=20
# AI_AUTO_REPLY_DELAY_MS=180000
